<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.github.viaconbodhi.cctr.aiguide.dev" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>CCTR AI Guide Phase 1 resize diagnostic. No backend connected.</description>
    <author name="CCTR" email="infoserv@vcu.edu" organization="CCTR" website="https://github.com/viaConBodhi/Tableau_Chatbot_UI"/>
    <min-api-version>1.7</min-api-version>
    <source-location>
      <url>https://dev-tableau-chatbot-ui.algo-alert-cramer.workers.dev/</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">AI Guide (dev)</text>
    </resource>
  </resources>
</manifest>
